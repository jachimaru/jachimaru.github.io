        <div class="wrapper">
            <header>
                <img src="/images/logo.png" alt="Logo depicting 'JHY' in purple." class="logo">

                <%- include('./partials/nav.ejs') %>
            </header>

            <main>
                <h1 class="title-background">Blog</h1>

                <div class="two-column-blog">
                    <div class="sticky-bar">
                        <!-- search bar area -->
                        <div>
                            <h2 class="title-background">By Project</h2>
                        </div>

                        <nav class="categories">
                            <p><a href="blog.html">Setting Up</a></p>
                            <p><a href="blog.html">Game Dev</a></p>
                            <p><a href="blog.html">Web Design</a></p>
                            <p><a href="blog.html">Other Programs</a></p>
                            <p><a href="blog.html">Personal</a></p>
                        </nav>
                    </div>

                    <div class="section-background">
                        <!-- blogs area -->
                         <h2 class="title-background">Recent Posts</h2>
                         <% if (blogs.length >0) { %>
                            <% blogs.forEach(blog => { %>
                                <div class="blog-post">
                                    <div class="blog-title blog-background">
                                        <h3><a href="/<%= blog._id %>"><%= blog.title %></a></h3>
                                        <h3><%= blog.date %></h3>
                                    </div>
                                    <div class="blog-preview">
                                        <p><%= blog.preview %></p>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <p>There are no blogs to display...</p>
                        <% } %>

