                            <div class="two-column-project">
                                <div>
                                    <p>A responsive website designed to house my blog and work as an online portfolio.</p>
                                    <p>Status: Completed (06/06/2026)</p>
                                    <p>Languages: HTML and CSS</p>
                                </div>
                                <img src="/images/logo.png" alt="">
                            </div>

                            <div class="columned-content">
